# Above Live — backend environment configuration
#
# Copy this file to ".env" to override values from data/settings.json.
# Everything here is OPTIONAL. With no .env at all, Above Live runs in MOCK mode.

# --- Server ---
# Port the backend listens on (REST + WebSocket).
PORT=4000

# --- Home location (overrides settings.json) ---
# HOME_LAT=32.7767
# HOME_LON=-96.797
# RANGE_NM=60

# --- Active data provider ---
# One of: MOCK | API | LOCAL_ADSB
# If omitted, the value from data/settings.json is used (default MOCK).
# PROVIDER=MOCK

# ===========================================================================
# API PROVIDER SETTINGS (only used when PROVIDER=API)
# ===========================================================================

# --- Which API adapter to use ---
# One of: airplaneslive | opensky | adsbexchange | generic
# Default: airplaneslive (free, no key required — good for testing)
# API_PROVIDER=airplaneslive

# ---------------------------------------------------------------------------
# Adapter: airplaneslive  (free, no key — DEFAULT)
# ---------------------------------------------------------------------------
# No extra settings needed. Just set PROVIDER=API and you're done.
# API_PROVIDER=airplaneslive

# ---------------------------------------------------------------------------
# Adapter: opensky  (free, anonymous access — rate limited)
# ---------------------------------------------------------------------------
# No key needed for anonymous access. Optional: set API_KEY=user:password
# for a free account (higher rate limits).
# API_PROVIDER=opensky
# API_KEY=yourusername:yourpassword

# ---------------------------------------------------------------------------
# Adapter: adsbexchange  (requires RapidAPI key)
# ---------------------------------------------------------------------------
# Get a key at https://rapidapi.com/adsbx/api/adsbexchange-com1
# API_PROVIDER=adsbexchange
# API_KEY=your_rapidapi_key_here

# ---------------------------------------------------------------------------
# Adapter: generic  (any REST API)
# ---------------------------------------------------------------------------
# Point at any JSON endpoint that returns aircraft near a lat/lon/radius.
# The adapter appends ?lat={lat}&lon={lon}&radius={nm} to the base URL.
# API_PROVIDER=generic
# API_BASE_URL=https://your-flight-api.example.com
# API_KEY=your_bearer_token_here

# ===========================================================================
# LOCAL ADS-B PROVIDER (only used when PROVIDER=LOCAL_ADSB)
# ===========================================================================

# URL to a dump1090 / readsb aircraft.json endpoint...
# LOCAL_ADSB_URL=http://localhost:8080/data/aircraft.json
# ...or an absolute file path to a local aircraft.json file.
# LOCAL_ADSB_PATH=/run/dump1090-fa/aircraft.json

# ===========================================================================
# OPTIONAL OVERLAY LAYERS (off by default in V1)
# ===========================================================================
# Satellite/ISS and weather layers ship in the code but are disabled by
# default. Enable them in data/settings.json ("layers" block) and restart.
# They need NO API key and fall back gracefully with no internet.
