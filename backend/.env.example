# Above Live — backend environment configuration (all optional)
#
# Copy this file to ".env" to override values from data/settings.json.
# Everything here is OPTIONAL. With no .env at all, Above Live runs in MOCK mode.

# --- Server ---
# Port the backend listens on (REST + WebSocket).
PORT=4000

# --- Active data provider ---
# One of: MOCK | API | LOCAL_ADSB
# If omitted, the value from data/settings.json is used (default MOCK).
# PROVIDER=MOCK

# --- Internet flight API provider (only used when PROVIDER=API) ---
# Base URL of the flight API you intend to use later.
# API_BASE_URL=https://example-flight-api.com
# API key for that service. If empty, the API provider fails gracefully
# and Above Live automatically falls back to MOCK mode.
# API_KEY=

# --- Local ADS-B provider (only used when PROVIDER=LOCAL_ADSB) ---
# URL to a dump1090 / readsb aircraft.json endpoint...
# LOCAL_ADSB_URL=http://localhost:8080/data/aircraft.json
# ...or an absolute file path to a local aircraft.json file.
# LOCAL_ADSB_PATH=/run/dump1090-fa/aircraft.json

# --- Space + Weather overlay layers ---
# These run automatically and need NO API key. The space layer tracks the live
# ISS (via the free wheretheiss.at API) plus a modeled satellite constellation;
# weather uses the free Open-Meteo API for your home location. If either service
# is unreachable, Above Live keeps running: the space layer falls back to its
# modeled satellites and weather simply shows the last good reading (or nothing).
# Toggle the layers in the UI (Display tab) or in data/settings.json ("layers").
