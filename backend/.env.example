# Above Live — backend environment configuration (all optional)
#
# Copy this file to ".env" to override values from data/settings.json.
# Everything here is OPTIONAL. With no .env at all, Above Live runs in MOCK mode.

# --- Server ---
# Port the backend listens on (REST + WebSocket).
PORT=4000

# --- Active data provider ---
# One of: MOCK | API | LOCAL_ADSB
# If omitted, the value from data/settings.json is used (default MOCK).
# PROVIDER=MOCK

# --- Internet flight API provider (only used when PROVIDER=API) ---
# Base URL of the flight API. Defaults to the free Airplanes.live point API,
# which needs no key. Above Live queries: {API_BASE_URL}/point/{lat}/{lon}/{rangeNm}
# API_BASE_URL=https://api.airplanes.live/v2
# API key (only for APIs that require one — Airplanes.live does not). If a key
# is set it is sent as "Authorization: Bearer <key>". If a chosen API needs a
# key and none is present, the API provider falls back to MOCK gracefully.
# API_KEY=
#
# How often Above Live actually calls the external API (milliseconds). The
# WebSocket/poll loop still updates clients every ~1s, but using CACHED data
# between these fetches. Keep this comfortably high to avoid rate limits.
# API_POLL_INTERVAL_MS=60000
#
# After an HTTP 429 (rate limit), wait at least this long before calling the API
# again (milliseconds). Cached aircraft keep showing during the backoff.
# API_RATE_LIMIT_BACKOFF_MS=120000
#
# Rapid settings changes (range slider, home) are coalesced into a single
# re-fetch this long after they settle, so they can't hammer the API.
# API_SETTINGS_DEBOUNCE_MS=3000

# --- Local ADS-B provider (only used when PROVIDER=LOCAL_ADSB) ---
# Reads decoded aircraft from a dump1090 / readsb "aircraft.json". Above Live
# does NOT decode radio — run dump1090-fa / readsb / tar1090 and point at it.
# URL is preferred if both URL and PATH are set.
# PROVIDER=LOCAL_ADSB
# URL to an aircraft.json endpoint. Common locations:
#   http://localhost:8080/data/aircraft.json
#   http://localhost:8080/tar1090/data/aircraft.json
#   http://localhost/dump1090-fa/data/aircraft.json
# LOCAL_ADSB_URL=http://localhost:8080/data/aircraft.json
# ...or an absolute file path to a local aircraft.json file. Common locations:
#   /run/dump1090-fa/aircraft.json
#   /run/readsb/aircraft.json
#   /var/run/dump1090-fa/aircraft.json
# LOCAL_ADSB_PATH=
# (LOCAL_ADSB_FILE is accepted as an alias for LOCAL_ADSB_PATH.)
# LOCAL_ADSB_FILE=
# How often to read the local feed (ms). Local data is cheap, so poll fast.
# LOCAL_ADSB_POLL_INTERVAL_MS=1000

# ===========================================================================
# OPTIONAL DISPLAY LAYERS — all OFF by default. Aircraft is the mission; these
# never block or crash the aircraft display. Each caches + fails soft.
# ===========================================================================

# --- Weather layer (centered on home) ---
# Provider "openmeteo" (free, no key) or "mock" (offline demo data).
# WEATHER_ENABLED=false
# WEATHER_PROVIDER=openmeteo
# WEATHER_POLL_INTERVAL_MS=300000

# --- ISS layer (CelesTrak TLE, propagated locally; no key) ---
# Downloads the "stations" group once (cached for hours) and propagates the ISS
# sub-point locally. No external call happens in the 1 Hz aircraft loop.
# ISS_ENABLED=false

# --- Satellites layer (CelesTrak TLE group, propagated locally; no key) ---
# Default group "visual" (the brightest naked-eye satellites). Capped to keep
# the display readable (settings.satellites.cap, default 60).
# SATELLITES_ENABLED=false
# SATELLITE_GROUP=visual
# SATELLITE_POLL_INTERVAL_MS=5000     # LOCAL propagation cadence (not a download)

# --- Starlink layer (CelesTrak "starlink" TLE group; no key) ---
# OFF by default. Rendered dim and capped (settings.starlink.cap, default 25)
# to avoid clutter.
# STARLINK_ENABLED=false

# --- Space layer (Sun, Moon, planets via local ephemeris; no network) ---
# Sun/Moon/Venus/Mars/Jupiter/Saturn as azimuth/elevation on the sky dome,
# plus moon phase and day/night. Recomputed locally every minute by default.
# SPACE_ENABLED=false
# SPACE_POLL_INTERVAL_MS=60000

# --- Starfield background (local, no network; on by default) ---
# STARS_ENABLED=true
